{
  "version": 1,
  "root": "window",
  "windows": ["window", "newProjectDialog", "drawSettingsDialog"],
  "nodes": {
    "window": {
      "type": "Window",
      "width": 1280,
      "height": 800,
      "title": "AnimeAn 动画工作台",
      "menuBar": {
        "height": 28,
        "menus": [
          {
            "id": "fileMenu",
            "title": "文件",
            "items": [
              { "id": "menuNewProject", "text": "新建项目...", "shortcut": "Ctrl+N", "emit": "openNewProject" },
              { "id": "menuOpenProject", "text": "打开项目...", "shortcut": "Ctrl+O", "emit": "openProjectFile" },
              { "id": "menuSaveProject", "text": "保存项目", "shortcut": "Ctrl+S", "emit": "saveProjectFile" },
              { "id": "menuSaveAsProject", "text": "另存为...", "shortcut": "Ctrl+Shift+S", "emit": "saveAsProjectFile" },
              {
                "id": "menuExportSub",
                "text": "导入与导出",
                "items": [
                  { "id": "menuImportImage", "text": "导入图像素材...", "shortcut": "Ctrl+I", "emit": "importImageAsset" },
                  { "id": "menuExportClip", "text": "导出视频片段...", "shortcut": "Ctrl+E", "emit": "triggerExportClip" }
                ]
              }
            ]
          },
          {
            "id": "viewMenu",
            "title": "视图",
            "items": [
              { "id": "menuToggleTools", "text": "工具栏", "dock": "toolsDock", "checkable": true, "checked": true },
              { "id": "menuToggleLayers", "text": "图层与素材面板", "dock": "layersDock", "checkable": true, "checked": true },
              { "id": "menuToggleInspector", "text": "选项与检查器面板", "dock": "inspectorDock", "checkable": true, "checked": true },
              { "id": "menuToggleTimeline", "text": "时间轴面板", "dock": "timelineDock", "checkable": true, "checked": true },
              { "id": "menuOnionSkinToggle", "text": "洋葱皮透视", "shortcut": "O", "checkable": true, "checked": false, "emit": "toggleOnionSkin" },
              { "id": "menuResetLayout", "text": "重置工作区布局", "emit": "resetWorkspaceLayout" }
            ]
          },
          {
            "id": "editMenu",
            "title": "编辑",
            "items": [
              { "id": "menuUndo", "text": "撤销", "shortcut": "Ctrl+Z", "emit": "undoHistory" },
              { "id": "menuRedo", "text": "重做", "shortcut": "Ctrl+Y", "emit": "redoHistory" },
              { "id": "menuClearFrame", "text": "清空当前帧", "shortcut": "Del", "emit": "clearCurrentFrame" }
            ]
          },
          {
            "id": "autoMappingMenu",
            "title": "自动映射",
            "items": [
              { "id": "menuAutoColorize", "text": "一键自动上色", "shortcut": "Alt+C", "emit": "runAutoColorize" },
              { "id": "menuAutoInbetween", "text": "生成中间帧补间", "shortcut": "Alt+I", "emit": "runAutoInbetween" },
              { "id": "menuTextureSync", "text": "同步纹理映射", "emit": "syncTextureMapping" }
            ]
          },
          {
            "id": "drawMenu",
            "title": "绘图设置",
            "items": [
              { "id": "menuDrawSettings", "text": "画笔与压感设置...", "shortcut": "F5", "emit": "openDrawSettings" },
              {
                "id": "menuStabilizerSub",
                "text": "抖动修正等级",
                "items": [
                  { "id": "menuStabOff", "text": "关闭修正 (S0)", "kind": "radio", "group": "stabilizerGroup", "checked": false, "emit": "setStabilizerOff" },
                  { "id": "menuStabMed", "text": "标准修正 (S5)", "kind": "radio", "group": "stabilizerGroup", "checked": true, "emit": "setStabilizerMed" },
                  { "id": "menuStabHigh", "text": "强力平滑 (S12)", "kind": "radio", "group": "stabilizerGroup", "checked": false, "emit": "setStabilizerHigh" }
                ]
              }
            ]
          },
          {
            "id": "themeMenu",
            "title": "主题",
            "items": [
              { "id": "menuThemeDark", "text": "深色创作主题", "kind": "radio", "group": "themeGroup", "checked": true, "emit": "setThemeDark" },
              { "id": "menuThemeGraphite", "text": "石墨灰护眼主题", "kind": "radio", "group": "themeGroup", "checked": false, "emit": "setThemeGraphite" },
              { "id": "menuThemeLight", "text": "明亮浅色主题", "kind": "radio", "group": "themeGroup", "checked": false, "emit": "setThemeLight" }
            ]
          }
        ]
      },
      "statusBar": "statusBar",
      "central": "centralArea",
      "docks": ["toolsDock", "layersDock", "inspectorDock", "timelineDock"],
      "children": ["toolsDock", "layersDock", "centralArea", "inspectorDock", "timelineDock", "statusBar"]
    },

    "toolsDock": {
      "type": "Dock",
      "dockArea": "top",
      "width": 1280,
      "height": 64,
      "headerHeight": 26,
      "title": "工具栏",
      "layout": { "kind": "hbox", "padding": [4, 12, 4, 12], "gap": 6 },
      "children": [
        "newProjectBtn",
        "toolbarSep1",
        "toolBrushBtn",
        "toolEraserBtn",
        "toolFillBtn",
        "toolShapeBtn",
        "toolSelectBtn",
        "toolMoveBtn",
        "toolEyedropperBtn",
        "toolbarSep2",
        "toolMoreMenuBtn",
        "toolbarSpacer",
        "projectSummaryLabel"
      ]
    },
    "newProjectBtn": {
      "type": "Button",
      "width": 88,
      "height": 30,
      "props": { "text": "新建项目", "variant": "primary", "icon": "add" }
    },
    "toolbarSep1": {
      "type": "Separator",
      "width": 6,
      "height": 30,
      "props": { "orientation": "vertical" }
    },
    "toolBrushBtn": {
      "type": "Button",
      "width": 64,
      "height": 30,
      "props": { "text": "画笔", "variant": "primary", "icon": "pen", "checkable": true, "checked": true }
    },
    "toolEraserBtn": {
      "type": "Button",
      "width": 64,
      "height": 30,
      "props": { "text": "橡皮", "variant": "secondary", "icon": "eraser", "checkable": true, "checked": false }
    },
    "toolFillBtn": {
      "type": "Button",
      "width": 64,
      "height": 30,
      "props": { "text": "填充", "variant": "secondary", "icon": "bucket", "checkable": true, "checked": false }
    },
    "toolShapeBtn": {
      "type": "Button",
      "width": 64,
      "height": 30,
      "props": { "text": "几何", "variant": "secondary", "icon": "shape", "checkable": true, "checked": false }
    },
    "toolSelectBtn": {
      "type": "Button",
      "width": 64,
      "height": 30,
      "props": { "text": "套索", "variant": "secondary", "icon": "lasso", "checkable": true, "checked": false }
    },
    "toolMoveBtn": {
      "type": "Button",
      "width": 64,
      "height": 30,
      "props": { "text": "移动", "variant": "secondary", "icon": "move", "checkable": true, "checked": false }
    },
    "toolEyedropperBtn": {
      "type": "Button",
      "width": 64,
      "height": 30,
      "props": { "text": "吸管", "variant": "secondary", "icon": "eyedropper", "checkable": true, "checked": false }
    },
    "toolbarSep2": {
      "type": "Separator",
      "width": 6,
      "height": 30,
      "props": { "orientation": "vertical" }
    },
    "toolMoreMenuBtn": {
      "type": "Button",
      "width": 84,
      "height": 30,
      "props": { "text": "工具预设 ▾", "variant": "secondary" },
      "popupMenu": [
        { "id": "popupResetTool", "text": "重置当前工具参数", "emit": "resetActiveToolOptions" },
        { "id": "popupOpenDrawSettings", "text": "打开压感设置...", "emit": "openDrawSettings" }
      ]
    },
    "toolbarSpacer": {
      "type": "Spacer",
      "width": 40,
      "height": 30,
      "size": { "stretch": 1, "horizontal": "expanding" },
      "props": { "orientation": "horizontal" }
    },
    "projectSummaryLabel": {
      "type": "Label",
      "width": 210,
      "height": 30,
      "props": { "text": "样片镜头 (1920x1080)", "tone": "muted", "align": "right" }
    },

    "layersDock": {
      "type": "Dock",
      "dockArea": "left",
      "width": 260,
      "height": 552,
      "headerHeight": 26,
      "title": "图层与素材",
      "layout": { "kind": "vbox", "padding": 8, "gap": 6 },
      "children": [
        "layerToolbar",
        "layerTree",
        "layerList",
        "layerVisibilityBar",
        "assetsPanelSep",
        "assetsHeaderBar",
        "assetList",
        "assetNoteInput"
      ]
    },
    "layerToolbar": {
      "type": "HBox",
      "width": 244,
      "height": 28,
      "layout": { "kind": "hbox", "padding": 0, "gap": 4 },
      "children": ["addLayerBtn", "addGroupBtn", "removeLayerBtn", "moveLayerUpBtn", "moveLayerDownBtn"]
    },
    "addLayerBtn": {
      "type": "Button",
      "width": 46,
      "height": 28,
      "props": { "text": "新建", "variant": "primary" }
    },
    "addGroupBtn": {
      "type": "Button",
      "width": 46,
      "height": 28,
      "props": { "text": "建组", "variant": "secondary" }
    },
    "removeLayerBtn": {
      "type": "Button",
      "width": 46,
      "height": 28,
      "props": { "text": "删除", "variant": "danger" }
    },
    "moveLayerUpBtn": {
      "type": "Button",
      "width": 45,
      "height": 28,
      "props": { "text": "上移", "variant": "secondary" }
    },
    "moveLayerDownBtn": {
      "type": "Button",
      "width": 45,
      "height": 28,
      "props": { "text": "下移", "variant": "secondary" }
    },
    "layerTree": {
      "type": "Tree",
      "width": 244,
      "height": 116,
      "props": { "items": [], "value": 0, "checkable": true, "draggable": true },
      "contextMenu": [
        { "id": "ctxDuplicateLayer", "text": "复制选中图层", "emit": "duplicateSelectedLayer" },
        { "id": "ctxToggleLockLayer", "text": "切换图层锁定", "emit": "toggleSelectedLayerLock" },
        { "id": "ctxDeleteLayer", "text": "删除选中图层", "emit": "deleteSelectedLayer" }
      ]
    },
    "layerList": {
      "type": "List",
      "width": 244,
      "height": 100,
      "size": { "stretch": 1, "vertical": "expanding" },
      "props": { "items": [], "value": 0, "draggable": true }
    },
    "layerVisibilityBar": {
      "type": "HBox",
      "width": 244,
      "height": 28,
      "layout": { "kind": "hbox", "padding": 0, "gap": 6 },
      "children": ["layerVisibleLabel", "toggleVisibleBtn"]
    },
    "layerVisibleLabel": {
      "type": "Label",
      "width": 138,
      "height": 28,
      "size": { "stretch": 1, "horizontal": "expanding" },
      "props": { "text": "当前图层：显示", "tone": "normal" }
    },
    "toggleVisibleBtn": {
      "type": "Button",
      "width": 100,
      "height": 28,
      "props": { "text": "隐藏图层", "variant": "secondary" }
    },
    "assetsPanelSep": {
      "type": "Separator",
      "width": 244,
      "height": 4,
      "props": { "orientation": "horizontal" }
    },
    "assetsHeaderBar": {
      "type": "HBox",
      "width": 244,
      "height": 26,
      "layout": { "kind": "hbox", "padding": 0, "gap": 4 },
      "children": ["assetsTitleLabel", "addAssetBtn", "removeAssetBtn"]
    },
    "assetsTitleLabel": {
      "type": "Label",
      "width": 124,
      "height": 26,
      "size": { "stretch": 1, "horizontal": "expanding" },
      "props": { "text": "素材库 (Assets)", "tone": "title" }
    },
    "addAssetBtn": {
      "type": "Button",
      "width": 56,
      "height": 26,
      "props": { "text": "+ 导入", "variant": "secondary" }
    },
    "removeAssetBtn": {
      "type": "Button",
      "width": 56,
      "height": 26,
      "props": { "text": "- 移除", "variant": "secondary" }
    },
    "assetList": {
      "type": "List",
      "width": 244,
      "height": 76,
      "props": { "items": [], "value": 0, "draggable": true }
    },
    "assetNoteInput": {
      "type": "TextArea",
      "width": 244,
      "height": 56,
      "props": { "placeholder": "输入选中素材的备注说明...", "value": "" }
    },

    "centralArea": {
      "type": "VBox",
      "width": 724,
      "height": 552,
      "layout": { "kind": "vbox", "padding": 8, "gap": 6 },
      "children": ["canvasHeader", "canvasHost"]
    },
    "canvasHeader": {
      "type": "HBox",
      "width": 708,
      "height": 30,
      "layout": { "kind": "hbox", "padding": 0, "gap": 6 },
      "children": ["workspaceTabBar", "canvasTitleLabel", "zoomSlider", "activeToolLabel"]
    },
    "workspaceTabBar": {
      "type": "TabBar",
      "width": 148,
      "height": 30,
      "props": { "tabs": "Drawing,Texture", "value": 0 }
    },
    "canvasTitleLabel": {
      "type": "Label",
      "width": 240,
      "height": 30,
      "size": { "stretch": 1, "horizontal": "expanding" },
      "props": { "text": "画布：样片镜头", "tone": "title" }
    },
    "zoomSlider": {
      "type": "Slider",
      "width": 96,
      "height": 30,
      "props": { "min": 25, "max": 400, "step": 25, "value": 100 }
    },
    "activeToolLabel": {
      "type": "Label",
      "width": 116,
      "height": 30,
      "props": { "text": "当前工具：画笔", "tone": "muted", "align": "right" }
    },
    "canvasHost": {
      "type": "External",
      "width": 708,
      "height": 500,
      "size": { "stretch": 1, "vertical": "expanding" },
      "contextMenu": [
        { "id": "ctxResetZoom", "text": "重置画布缩放 (100%)", "emit": "resetCanvasZoom" },
        { "id": "ctxClearCanvas", "text": "清空当前帧画布", "emit": "clearCurrentFrame" }
      ]
    },

    "inspectorDock": {
      "type": "Dock",
      "dockArea": "right",
      "width": 296,
      "height": 552,
      "headerHeight": 26,
      "title": "工具选项与检查器",
      "layout": { "kind": "vbox", "padding": 8, "gap": 6 },
      "children": ["toolOptHeader", "toolOptionsForm", "inspectorSep1", "inspectorTabs", "inspectorStack"]
    },
    "toolOptHeader": {
      "type": "Label",
      "width": 280,
      "height": 22,
      "props": { "text": "工具选项 (Tool Options)", "tone": "title" }
    },
    "toolOptionsForm": {
      "type": "DataForm",
      "width": 280,
      "height": 172,
      "props": { "schema": {}, "values": {}, "emptyText": "当前工具无附加选项" }
    },
    "inspectorSep1": {
      "type": "Separator",
      "width": 280,
      "height": 4,
      "props": { "orientation": "horizontal" }
    },
    "inspectorTabs": {
      "type": "Grid",
      "width": 280,
      "height": 30,
      "layout": { "kind": "grid", "columns": 3, "gap": 4, "columnStretch": [1, 1, 1], "rowStretch": [0] },
      "children": ["tabPropsBtn", "tabHistoryBtn", "tabExportBtn"]
    },
    "tabPropsBtn": {
      "type": "Button",
      "row": 0,
      "column": 0,
      "width": 90,
      "height": 30,
      "props": { "text": "图层属性", "variant": "primary" }
    },
    "tabHistoryBtn": {
      "type": "Button",
      "row": 0,
      "column": 1,
      "width": 90,
      "height": 30,
      "props": { "text": "历史记录", "variant": "secondary" }
    },
    "tabExportBtn": {
      "type": "Button",
      "row": 0,
      "column": 2,
      "width": 90,
      "height": 30,
      "props": { "text": "渲染导出", "variant": "secondary" }
    },
    "inspectorStack": {
      "type": "Stack",
      "width": 280,
      "height": 258,
      "size": { "stretch": 1, "vertical": "expanding" },
      "layout": { "kind": "stack", "padding": 0 },
      "props": { "currentIndex": 0 },
      "children": ["layerPropsPage", "exportPage", "historyPage"]
    },
    "layerPropsPage": {
      "type": "Form",
      "width": 280,
      "height": 258,
      "layout": { "kind": "form", "padding": 4, "gap": 8, "labelWidth": 76 },
      "children": ["blendLabel", "blendCombo", "opacityLabel", "opacitySpin", "lockLabel", "lockLayerCheck"]
    },
    "blendLabel": {
      "type": "Label",
      "width": 76,
      "height": 30,
      "props": { "text": "混合模式", "tone": "muted" }
    },
    "blendCombo": {
      "type": "ComboBox",
      "width": 188,
      "height": 30,
      "props": { "options": "Normal,Multiply,Screen,Overlay", "value": "Normal" }
    },
    "opacityLabel": {
      "type": "Label",
      "width": 76,
      "height": 30,
      "props": { "text": "不透明度", "tone": "muted" }
    },
    "opacitySpin": {
      "type": "SpinBox",
      "width": 188,
      "height": 30,
      "props": { "min": 0, "max": 100, "step": 5, "value": 100 }
    },
    "lockLabel": {
      "type": "Label",
      "width": 76,
      "height": 30,
      "props": { "text": "锁定编辑", "tone": "muted" }
    },
    "lockLayerCheck": {
      "type": "CheckBox",
      "width": 188,
      "height": 30,
      "props": { "text": "锁定当前图层", "value": false }
    },
    "exportPage": {
      "type": "VBox",
      "width": 280,
      "height": 258,
      "layout": { "kind": "vbox", "padding": 4, "gap": 8 },
      "children": ["exportHintLabel", "exportBtn", "exportResultLabel"]
    },
    "exportHintLabel": {
      "type": "Label",
      "width": 272,
      "height": 28,
      "props": { "text": "导出当前动画镜头片段", "tone": "normal" }
    },
    "exportBtn": {
      "type": "Button",
      "width": 272,
      "height": 32,
      "props": { "text": "开始导出", "variant": "primary" }
    },
    "exportResultLabel": {
      "type": "Label",
      "width": 272,
      "height": 28,
      "props": { "text": "尚未导出", "tone": "muted" }
    },
    "historyPage": {
      "type": "VBox",
      "width": 280,
      "height": 258,
      "layout": { "kind": "vbox", "padding": 4, "gap": 6 },
      "children": ["historyToolbar", "historyList"]
    },
    "historyToolbar": {
      "type": "HBox",
      "width": 272,
      "height": 28,
      "layout": { "kind": "hbox", "padding": 0, "gap": 6 },
      "children": ["undoBtn", "redoBtn", "clearHistoryBtn"]
    },
    "undoBtn": {
      "type": "Button",
      "width": 86,
      "height": 28,
      "props": { "text": "撤销", "variant": "secondary" }
    },
    "redoBtn": {
      "type": "Button",
      "width": 86,
      "height": 28,
      "props": { "text": "重做", "variant": "secondary" }
    },
    "clearHistoryBtn": {
      "type": "Button",
      "width": 88,
      "height": 28,
      "props": { "text": "清空历史", "variant": "danger" }
    },
    "historyList": {
      "type": "List",
      "width": 272,
      "height": 216,
      "size": { "stretch": 1, "vertical": "expanding" },
      "props": { "items": [], "value": 2, "mutedFrom": -1 }
    },

    "timelineDock": {
      "type": "Dock",
      "dockArea": "bottom",
      "width": 1280,
      "height": 132,
      "headerHeight": 26,
      "title": "时间轴",
      "layout": { "kind": "vbox", "padding": [6, 12, 6, 12], "gap": 6 },
      "children": ["timelineTransportFlow", "timelineTrackRow"]
    },
    "timelineTransportFlow": {
      "type": "Flow",
      "width": 1256,
      "height": 28,
      "layout": { "kind": "flow", "padding": 0, "columnGap": 8, "rowGap": 4 },
      "children": [
        "playToggleBtn",
        "prevFrameBtn",
        "nextFrameBtn",
        "addFrameBtn",
        "removeFrameBtn",
        "loopToggleBtn",
        "onionToggleBtn",
        "fpsSelectCombo",
        "frameSlider",
        "frameInfoLabel"
      ]
    },
    "playToggleBtn": {
      "type": "Button",
      "width": 78,
      "height": 28,
      "props": { "text": "播放", "variant": "primary", "icon": "play", "checkable": true, "checked": false }
    },
    "prevFrameBtn": {
      "type": "Button",
      "width": 72,
      "height": 28,
      "props": { "text": "上一帧", "variant": "secondary" }
    },
    "nextFrameBtn": {
      "type": "Button",
      "width": 72,
      "height": 28,
      "props": { "text": "下一帧", "variant": "secondary" }
    },
    "addFrameBtn": {
      "type": "Button",
      "width": 78,
      "height": 28,
      "props": { "text": "+ 关键帧", "variant": "secondary" }
    },
    "removeFrameBtn": {
      "type": "Button",
      "width": 78,
      "height": 28,
      "props": { "text": "- 删除帧", "variant": "secondary" }
    },
    "loopToggleBtn": {
      "type": "Button",
      "width": 74,
      "height": 28,
      "props": { "text": "循环播放", "variant": "secondary", "checkable": true, "checked": true }
    },
    "onionToggleBtn": {
      "type": "Button",
      "width": 74,
      "height": 28,
      "props": { "text": "洋葱皮", "variant": "secondary", "checkable": true, "checked": false }
    },
    "fpsSelectCombo": {
      "type": "ComboBox",
      "width": 92,
      "height": 28,
      "props": { "options": "12 fps,24 fps,30 fps", "value": "24 fps" }
    },
    "frameSlider": {
      "type": "Slider",
      "width": 180,
      "height": 28,
      "props": { "min": 1, "max": 24, "step": 1, "value": 1 }
    },
    "frameInfoLabel": {
      "type": "Label",
      "width": 170,
      "height": 28,
      "props": { "text": "当前帧：1 / 24", "tone": "normal" }
    },
    "timelineTrackRow": {
      "type": "HBox",
      "width": 1256,
      "height": 26,
      "layout": { "kind": "hbox", "padding": 0, "gap": 8 },
      "children": ["timelineTrackLabel", "timelineScrollBar", "timelineOffsetLabel"]
    },
    "timelineTrackLabel": {
      "type": "Label",
      "width": 110,
      "height": 26,
      "props": { "text": "时间轴视口滚动", "tone": "muted" }
