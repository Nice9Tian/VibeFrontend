              "set": "project.currentFrame = project.currentFrame + 1"
            }
          ]
        }
      },
      "frameInfoLabel": {
        "props": {
          "text": "\"当前帧：\" + project.currentFrame + \" / \" + project.fps"
        }
      },
      "statusTextLabel": {
        "props": {
          "text": "project.statusMessage"
        }
      },
      "statusLayerCountLabel": {
        "props": {
          "text": "\"图层数：\" + layers.items.length"
        }
      },
      "newProjectDialog": {
        "doc": "docs/window.md#new-project-dialog"
      },
      "projectNameInput": {
        "bind": "newProject.name"
      },
      "presetCombo": {
        "bind": "newProject.preset",
        "events": {
          "change": [
            {
              "fn": "syncPresetDimensions"
            }
          ]
        }
      },
      "widthSpin": {
        "bind": "newProject.width"
      },
      "heightSpin": {
        "bind": "newProject.height"
      },
      "transparentCheck": {
        "bind": "newProject.transparent"
      },
      "cancelNewProjectBtn": {
        "events": {
          "click": [
            {
              "closeWindow": "newProjectDialog"
            },
            {
              "set": "project.statusMessage = \"已取消新建项目\""
            }
          ]
        }
      },
      "confirmNewProjectBtn": {
        "events": {
          "click": [
            {
              "set": "project.title = newProject.name"
            },
            {
              "set": "project.width = newProject.width"
            },
            {
              "set": "project.height = newProject.height"
            },
            {
              "set": "project.fps = newProject.fps"
            },
            {
              "set": "project.transparent = newProject.transparent"
            },
            {
              "closeWindow": "newProjectDialog"
            },
            {
