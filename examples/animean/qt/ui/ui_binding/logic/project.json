        "props": {
          "text": "\"画布：\" + project.title"
        }
      },
      "activeToolLabel": {
        "props": {
          "text": "isBrush ? \"当前工具：画笔\" : (isEraser ? \"当前工具：橡皮\" : \"当前工具：填充\")"
        }
      },
      "canvasHost": {
        "doc": "docs/window.md#canvas-host"
      },
      "inspectorDock": {
        "doc": "docs/window.md#inspector-dock"
      },
      "tabPropsBtn": {
        "props": {
          "variant": "isPropsTab ? \"primary\" : \"secondary\""
        },
        "events": {
          "click": [
            {
              "set": "inspector.tabIndex = 0"
            }
          ]
        }
      },
      "tabExportBtn": {
        "props": {
          "variant": "isExportTab ? \"primary\" : \"secondary\""
        },
        "events": {
          "click": [
            {
              "set": "inspector.tabIndex = 1"
            }
          ]
        }
      },
      "inspectorStack": {
        "props": {
          "currentIndex": "inspector.tabIndex"
        }
      },
      "blendCombo": {
        "bind": "layer.blendMode"
      },
      "opacitySpin": {
        "bind": "layer.opacity"
      },
      "lockLayerCheck": {
        "bind": "layer.locked",
        "events": {
          "change": [
            {
              "set": "layers.items[layers.selectedIndex].locked = layer.locked"
            }
          ]
        }
      },
      "exportBtn": {
        "events": {
          "click": [
            {
              "call": "exportClip"
            }
          ]
        }
      },
      "exportResultLabel": {
        "props": {
          "text": "project.exportResult"
        }
      },
      "timelineDock": {
        "doc": "docs/window.md#timeline-dock"
      },
      "prevFrameBtn": {
        "props": {
          "enabled": "project.currentFrame > 1"
        },
        "events": {
          "click": [
            {
              "if": "project.currentFrame > 1",
              "then": [
                {
                  "set": "project.currentFrame = project.currentFrame - 1"
                }
              ]
            }
          ]
        }
      },
      "nextFrameBtn": {
        "events": {
          "click": [
