  "functions": {
    "syncPresetDimensions": "// 根据新建项目对话框里选择的画幅预设，返回对应的画布宽高和帧率。\nexport default function syncPresetDimensions(state) {\n  const preset = state.newProject?.preset ?? \"1080p\";\n  if (preset === \"720p\") {\n    return {\n      \"newProject.width\": 1280,\n      \"newProject.height\": 720,\n      \"newProject.fps\": 24,\n    };\n  }\n  if (preset === \"Square\") {\n    return {\n      \"newProject.width\": 1080,\n      \"newProject.height\": 1080,\n      \"newProject.fps\": 30,\n    };\n  }\n  return {\n    \"newProject.width\": 1920,\n    \"newProject.height\": 1080,\n    \"newProject.fps\": 24,\n  };\n}\n"
  },
  "actionSources": {
    "exportClip": "// 导出当前动画镜头片段（支持同步或异步返回 Promise）。\nexport default async function exportClip(input) {\n  const title = input?.title ?? \"未命名镜头\";\n  const count = input?.layerCount ?? 0;\n  return {\n    outputPath: `exports/${title}.mp4`,\n    summary: `已导出 ${title}（${count} 个图层）`,\n  };\n}\n"
  }
}
